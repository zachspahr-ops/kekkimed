  "meta": {
    "name": "Kekki Internal Medicine Ontology",
    "version": "0.1.0",
    "drafted": "2026-04-23",
    "basis": "ABIM MOC blueprint categories (structural scaffold) + reconstructed CDIM-SGIM/AAIM core training problems (topic grain). AAIM 2021 curriculum (Part 1: diseases/conditions/presentations) should be used to verify and extend.",
    "use": "Controlled vocabulary for LLM intake parser and plan generator. Every structured_analytics row must map to an id in this file. LLM is prompted to select the closest id and return null rather than invent a new one.",
    "depth_levels": {
      "1": "Domain (system)",
      "2": "Subdomain (disease family / problem cluster)",
      "3": "Topic (specific clinical problem or presentation)"
    },
    "open_questions": [
      "Verify domain weights vs current ABIM blueprint percentages.",
      "Verify topic grain against AAIM 2021 Part 1 training problems.",
      "Decide whether cross-cutting themes (e.g., preventive care, geriatrics) get their own domain or live as tags across systems.",
      "Add synonyms for every topic before production use; current synonyms are illustrative only."
    ]
  },
